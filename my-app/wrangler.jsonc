{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-app",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-24",
	// "compatibility_flags": [
	//   "nodejs_compat"
	// ],
	// "vars": {
	//   "MY_VAR": "my-variable"
	// },
	// "kv_namespaces": [
	//   {
	//     "binding": "MY_KV_NAMESPACE",
	//     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
	//   }
	// ],
	// "r2_buckets": [
	//   {
	//     "binding": "MY_BUCKET",
	//     "bucket_name": "my-bucket"
	//   }
	// ],
	"d1_databases": [
		{
			"binding": "infinitybot",
			"database_name": "infinitybot",
			"database_id": "d44e137f-06a6-4a58-a64b-13c4be21d38e",
			"migrations_dir": "drizzle",
			"migrations_pattern": "drizzle/*/migration.sql"
		}
	],
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "productos-demo",
			"remote": true
		}
	],
	"ai": {
		"binding": "AI"
	},
	// "observability": {
	//   "enabled": true,
	//   "head_sampling_rate": 1
	// }
}